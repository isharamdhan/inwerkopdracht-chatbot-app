# Copy this file to `.env`:  cp .env.example .env

# MySQL container (used by the `db` service)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=chatbot
MYSQL_USER=chatbot
MYSQL_PASSWORD=chatbot

# App -> database connection (used by mysql2). docker-compose overrides DB_HOST to `db`.
DB_HOST=localhost
DB_PORT=3306
DB_USER=chatbot
DB_PASSWORD=chatbot
DB_NAME=chatbot

# OpenAI
OPENAI_API_KEY=sk-your-key-here
